# ─────────────────────────────────────────────────────────────
# RetroCam Chat — variabili d'ambiente
# Copia questo file in `.env` e compila i valori del tuo progetto Supabase.
# ATTENZIONE: usa SOLO le chiavi pubbliche qui sotto.
# Non inserire MAI la service_role key o altri segreti nel frontend.
# ─────────────────────────────────────────────────────────────

# URL del progetto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chiave pubblica "anon" (Project Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# (Opzionale, Fase 2) Server STUN/TURN per WebRTC.
# Lo STUN pubblico di Google è sufficiente per molte reti; per reti
# restrittive/mobile serve un TURN server (vedi README).
# Formato JSON array di RTCIceServer.
# Esempio con TURN:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
