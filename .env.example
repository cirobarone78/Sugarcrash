# ─────────────────────────────────────────────────────────────
# RetroCam Chat — variabili d'ambiente (Firebase)
# Copia questo file in `.env` e compila con la config del tuo progetto Firebase.
#
# Questi valori sono PUBBLICI (la config web di Firebase non è segreta): la
# sicurezza è garantita dalle Security Rules di Firestore e Realtime Database.
# Non inserire MAI service account / chiavi private nel frontend.
#
# Dove trovarli: console Firebase → ⚙ Impostazioni progetto → Le tue app →
# App Web → "Configurazione SDK".
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=il-tuo-progetto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=il-tuo-progetto
VITE_FIREBASE_STORAGE_BUCKET=il-tuo-progetto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# URL del Realtime Database (Build → Realtime Database → copia l'URL in alto).
# Es. https://il-tuo-progetto-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=https://il-tuo-progetto-default-rtdb.firebasedatabase.app

# (Opzionale, Fase 2) Server STUN/TURN per WebRTC.
# Lo STUN pubblico di Google basta per molte reti; per reti restrittive/mobile
# serve un TURN server (vedi README). JSON array di RTCIceServer.
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
