rules_version = '2';

// ============================================================================
// RetroCam Chat — Security Rules Firestore (sostituiscono la RLS di Supabase)
// Deploy: console Firebase → Firestore → Regole (incolla), oppure
//   firebase deploy --only firestore:rules
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // L'utente è registrato (non ospite)? Lo deduciamo dal provider di accesso:
    // gli ospiti usano l'auth anonima, i registrati email/password (o altri).
    function isRegistered() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function threadParticipants(threadId) {
      return get(/databases/$(database)/documents/privateThreads/$(threadId)).data.participants;
    }

    // profiles: lettura pubblica, scrittura solo del proprio
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    // usernames: prenotazione del nickname univoco
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
      allow update: if false;
    }

    // stanze pubbliche (id statici): config lato client, niente scrittura
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if false;

      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.user_id == uid()
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // blocchi: solo il proprietario
    match /blocks/{blockerId}/list/{blockedId} {
      allow read, create, delete: if signedIn() && uid() == blockerId;
      allow update: if false;
    }

    // thread privati: solo i due partecipanti; creazione riservata ai registrati
    match /privateThreads/{threadId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if isRegistered()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && uid() in resource.data.participants;
      allow delete: if false;

      // messaggi privati: leggibili dai partecipanti; inviabili dal mittente registrato
      match /messages/{msgId} {
        allow read: if signedIn() && uid() in threadParticipants(threadId);
        allow create: if isRegistered()
          && request.resource.data.sender_id == uid()
          && uid() in threadParticipants(threadId)
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // sessioni webcam: solo i due partecipanti; chi è bloccato non può invitare
    match /webcamSessions/{sessionId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if isRegistered()
        && request.resource.data.broadcaster_id == uid()
        && uid() in request.resource.data.participants
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.viewer_id)/list/$(uid()));
      allow update: if signedIn() && uid() in resource.data.participants;
      allow delete: if false;
    }

    // segnalazioni: solo creazione da parte del segnalante
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter_id == uid();
      allow read, update, delete: if false;
    }

    // eventi di moderazione (es. consenso webcam): solo il proprietario
    match /moderation_events/{id} {
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow read: if signedIn() && resource.data.user_id == uid();
      allow update, delete: if false;
    }
  }
}
