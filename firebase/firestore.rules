rules_version = '2';

// ============================================================================
// RetroCam Chat — Security Rules Firestore (sostituiscono la RLS di Supabase)
// Deploy: console Firebase → Firestore → Regole (incolla), oppure
//   firebase deploy --only firestore:rules
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // L'utente è registrato (non ospite)? Lo deduciamo dal provider di accesso:
    // gli ospiti usano l'auth anonima, i registrati email/password (o altri).
    function isRegistered() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Profilo del chiamante (per legare i campi denormalizzati all'identità).
    function callerProfile() {
      return get(/databases/$(database)/documents/profiles/$(uid())).data;
    }

    // Allowlist immagine: solo data-URL immagine base64, dimensione limitata.
    function imageUrlOk(data) {
      return data.image_url is string
        && data.image_url.size() <= 210000
        && data.image_url.matches('^data:image/(png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+$');
    }

    // E2 — sottodoc `blob/full`: l'immagine ORIGINALE (data-URL) separata dal
    // messaggio, caricata solo su richiesta. Cap più ampio della miniatura.
    function fullImageOk(data) {
      return data.value is string
        && data.value.size() <= 400000
        && data.value.matches('^data:image/(png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+$');
    }

    // Validazione comune dei messaggi (stanze, stanze private, thread privati).
    // body ≤ 2000; message_type ∈ {text,image}; se image → image_url valido,
    // se text → image_url assente.
    function validMessage(data) {
      return data.body is string
        && data.body.size() <= 2000
        && data.message_type in ['text', 'image']
        && (data.message_type == 'image'
              ? imageUrlOk(data)
              : !('image_url' in data));
    }

    // Lega i campi autore denormalizzati al profilo del chiamante.
    function authorBound(data) {
      return data.author_username == callerProfile().username
        && data.author_avatar_url == callerProfile().avatar_url
        && data.author_is_guest == callerProfile().is_guest;
    }

    function threadParticipants(threadId) {
      return get(/databases/$(database)/documents/privateThreads/$(threadId)).data.participants;
    }

    // L'altro partecipante del thread (quello diverso dall'utente corrente).
    function otherParticipant(threadId) {
      return threadParticipants(threadId)[0] == uid()
        ? threadParticipants(threadId)[1]
        : threadParticipants(threadId)[0];
    }

    // True se 'blockerId' ha bloccato l'utente corrente.
    function blockedByCurrent(blockerId) {
      return exists(/databases/$(database)/documents/blocks/$(blockerId)/list/$(uid()));
    }

    // Validazione dei campi profilo auto-dichiarati (solo se presenti).
    // NB: l'obbligatorietà del `sex` è imposta lato client (attributo di profilo
    // auto-dichiarato, non controllo di sicurezza): qui validiamo solo il valore.
    function profileFieldsOk(data) {
      return (!('sex' in data) || data.sex in ['male', 'female', 'couple', 'undisclosed'])
        && (!('age' in data) || (data.age is int && data.age >= 18 && data.age <= 120))
        && (!('country' in data) || (data.country is string && data.country.size() <= 40));
    }

    // profiles: lettura pubblica, scrittura solo del proprio
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && profileFieldsOk(request.resource.data);
      allow delete: if false;
    }

    // usernames: prenotazione del nickname univoco
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
      allow update: if false;
    }

    // stanze pubbliche (id statici): config lato client, niente scrittura
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if false;

      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.user_id == uid()
          && validMessage(request.resource.data)
          && authorBound(request.resource.data);
        allow update, delete: if false;
      }
    }

    // blocchi: solo il proprietario
    match /blocks/{blockerId}/list/{blockedId} {
      allow read, create, delete: if signedIn() && uid() == blockerId;
      allow update: if false;
    }

    // thread privati: solo i due partecipanti; creazione riservata ai registrati
    match /privateThreads/{threadId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if isRegistered()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && uid() in resource.data.participants;
      allow delete: if false;

      // messaggi privati: leggibili dai partecipanti; inviabili dal mittente registrato
      match /messages/{msgId} {
        allow read: if signedIn() && uid() in threadParticipants(threadId);
        allow create: if isRegistered()
          && request.resource.data.sender_id == uid()
          && uid() in threadParticipants(threadId)
          && validMessage(request.resource.data)
          && !blockedByCurrent(otherParticipant(threadId));
        allow update, delete: if false;

        // E2: immagine originale, write-once, leggibile dai partecipanti.
        match /blob/{docId} {
          allow read: if signedIn() && uid() in threadParticipants(threadId);
          allow create: if isRegistered()
            && uid() in threadParticipants(threadId)
            && fullImageOk(request.resource.data);
          allow update, delete: if false;
        }
      }
    }

    // stanze private (create dagli utenti, password "soft" via hash salato).
    // L'hash NON sta nel doc leggibile: vive in privateRooms/{id}/secret/hash
    // (allow read: false; le rules possono leggerlo con get()). Il doc principale
    // espone solo il `salt` (non segreto).
    function roomPwdHash(roomId) {
      return get(/databases/$(database)/documents/privateRooms/$(roomId)/secret/hash).data.value;
    }
    function roomOwner(roomId) {
      return get(/databases/$(database)/documents/privateRooms/$(roomId)).data.owner_id;
    }
    function isRoomMember(roomId) {
      return exists(/databases/$(database)/documents/privateRooms/$(roomId)/members/$(uid()));
    }
    match /privateRooms/{roomId} {
      allow read: if signedIn();
      allow create: if isRegistered() && request.resource.data.owner_id == uid();
      allow update, delete: if signedIn() && resource.data.owner_id == uid();

      // segreto password: mai leggibile dai client, scrivibile solo dall'owner
      match /secret/{docId} {
        allow read: if false;
        allow create, update: if isRegistered()
          && roomOwner(roomId) == uid()
          && request.resource.data.value is string;
        allow delete: if signedIn() && roomOwner(roomId) == uid();
      }

      // membership: entri solo fornendo l'hash corretto della password
      match /members/{userId} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId
          && request.resource.data.pwd_hash == roomPwdHash(roomId);
        allow delete: if signedIn() && uid() == userId;
        allow update: if false;
      }

      // messaggi: leggibili/scrivibili solo dai membri
      match /messages/{msgId} {
        allow read: if signedIn() && isRoomMember(roomId);
        allow create: if signedIn()
          && isRoomMember(roomId)
          && request.resource.data.user_id == uid()
          && validMessage(request.resource.data)
          && authorBound(request.resource.data);
        allow update, delete: if false;

        // E2: immagine originale, write-once, leggibile dai membri.
        match /blob/{docId} {
          allow read: if signedIn() && isRoomMember(roomId);
          allow create: if signedIn()
            && isRoomMember(roomId)
            && fullImageOk(request.resource.data);
          allow update, delete: if false;
        }
      }
    }

    // sessioni webcam: solo i due partecipanti.
    // Creazione consentita in DUE modi (P5):
    //  - invito 1:1 ('invite'): lo crea il BROADCASTER (registrato), verso un
    //    viewer che non lo ha bloccato;
    //  - visione pubblica ('watch'): lo crea il VIEWER (anche ospite) verso un
    //    broadcaster che non lo ha bloccato.
    // In entrambi i casi il chiamante dev'essere tra i participants.
    match /webcamSessions/{sessionId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
        && uid() in request.resource.data.participants
        && (
          (request.resource.data.broadcaster_id == uid()
            && isRegistered()
            && !blockedByCurrent(request.resource.data.viewer_id))
          ||
          (request.resource.data.viewer_id == uid()
            && !blockedByCurrent(request.resource.data.broadcaster_id))
        );
      allow update: if signedIn() && uid() in resource.data.participants;
      allow delete: if false;
    }

    // amici/preferiti (accettazione reciproca). Un doc per coppia, id = uid
    // ordinati `a__b`. Il richiedente crea 'pending'; SOLO l'altro può portarlo
    // ad 'accepted'. Entrambi possono eliminare (rifiuta / annulla / rimuovi).
    match /friendships/{pairId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if isRegistered()
        && request.resource.data.requester == uid()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if isRegistered()
        && uid() in resource.data.participants
        && uid() != resource.data.requester
        && request.resource.data.requester == resource.data.requester
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && uid() in resource.data.participants;
    }

    // segnalazioni: solo creazione da parte del segnalante
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter_id == uid();
      allow read, update, delete: if false;
    }

    // eventi di moderazione (es. consenso webcam): solo il proprietario
    match /moderation_events/{id} {
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow read: if signedIn() && resource.data.user_id == uid();
      allow update, delete: if false;
    }
  }
}
