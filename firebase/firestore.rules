rules_version = '2';

// ============================================================================
// RetroCam Chat — Security Rules Firestore (sostituiscono la RLS di Supabase)
// Deploy: console Firebase → Firestore → Regole (incolla), oppure
//   firebase deploy --only firestore:rules
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // profiles: lettura pubblica (per mostrare nickname/avatar), scrittura solo del proprio
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    // usernames: prenotazione del nickname univoco (1 doc per nickname)
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
      allow update: if false;
    }

    // stanze pubbliche (id statici): config lato client, niente scrittura
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if false;

      // messaggi pubblici: leggibili dagli autenticati, scrivibili col proprio user_id
      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.user_id == uid()
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // blocchi: solo il proprietario li vede e gestisce
    match /blocks/{blockerId}/list/{blockedId} {
      allow read, create, delete: if signedIn() && uid() == blockerId;
      allow update: if false;
    }

    // thread privati: visibili/gestibili solo dai due partecipanti
    match /privateThreads/{threadId} {
      function threadDoc() {
        return get(/databases/$(database)/documents/privateThreads/$(threadId)).data;
      }
      function otherParty() {
        return threadDoc().participants[0] == uid()
          ? threadDoc().participants[1]
          : threadDoc().participants[0];
      }

      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && uid() in resource.data.participants;
      allow delete: if false;

      // messaggi privati: leggibili solo dai partecipanti; inviabili solo dal
      // mittente e solo se l'altro utente non lo ha bloccato
      match /messages/{msgId} {
        allow read: if signedIn() && uid() in threadDoc().participants;
        allow create: if signedIn()
          && request.resource.data.sender_id == uid()
          && uid() in threadDoc().participants
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && !exists(/databases/$(database)/documents/blocks/$(otherParty())/list/$(uid()));
        allow update, delete: if false;
      }
    }

    // sessioni webcam: solo i due partecipanti; chi è bloccato non può invitare
    match /webcamSessions/{sessionId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.broadcaster_id == uid()
        && uid() in request.resource.data.participants
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.viewer_id)/list/$(uid()));
      allow update: if signedIn() && uid() in resource.data.participants;
      allow delete: if false;
    }

    // segnalazioni: solo creazione da parte del segnalante (lettura riservata allo staff)
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter_id == uid();
      allow read, update, delete: if false;
    }

    // eventi di moderazione (es. consenso webcam): solo il proprietario
    match /moderation_events/{id} {
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow read: if signedIn() && resource.data.user_id == uid();
      allow update, delete: if false;
    }
  }
}
