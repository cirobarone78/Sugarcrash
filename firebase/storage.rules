rules_version = '2';

// ============================================================================
// RetroCam Chat — Security Rules Firebase Storage (immagini di chat)
// Deploy: console Firebase → Storage → Regole (incolla), oppure
//   firebase deploy --only storage
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    // Immagini di chat: ognuno scrive solo nella propria cartella, lettura
    // consentita agli utenti autenticati. Limite 5 MB e solo immagini.
    match /chat-images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // tutto il resto: negato
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
